# ═══════ NullBot 部署配置文件 ═══════ #
# 生产环境使用.                        #
# ══════════════════════════════════ #

nullbot:
  # ─── 文档 ─────────── #
  doc:
    enabled: false

  # ─── 日志 ─────────── #
  log:
    path: ./output.log
    level: INFO

  # ─── 数据 ─────────── #
  mysql:
    database: your_db
    username:
    password:

  # ─── 连接 ─────────── #
  shiro:
    url: /ws  # ws endpoint
    token:

  # ─── 适配 ─────────── #
  adapter: stdin  # type: stdin or shiro

  # ─── 文件 ─────────── #
  file:
    root: ./files
