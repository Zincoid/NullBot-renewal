# ═══════ NullBot 部署配置文件 ═══════ #
# 生产环境使用.                        #
# ══════════════════════════════════ #

nullbot:
  # ─── 管理 ─────────── #
  console:
    token:

  # ─── 日志 ─────────── #
  log:
    path: ./output.log
    level: INFO

  # ─── 数据 ─────────── #
  mysql:
    database: your_db
    username:
    password:

  # ─── 文件 ─────────── #
  file:
    root: ./files

  # ─── 连接 ─────────── #
  shiro:
    url: /ws
    token:

  # ─── 适配 ─────────── #
  adapter: shiro
