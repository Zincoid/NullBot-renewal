<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.zincoid</groupId>
    <artifactId>nullbot-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>NullBot Parent</name>
    <description>NullBot multi-module parent</description>

    <modules>
        <module>core</module>
        <module>hello-plugin</module>
    </modules>

    <properties>
        <java.version>27</java.version>
        <springdoc.version>3.1.0</springdoc.version>
        <lombok.version>1.18.48</lombok.version>
        <commons-io.version>2.22.0</commons-io.version>
        <bucket4j.version>8.14.0</bucket4j.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <shiro.version>2.5.5</shiro.version>
    </properties>
</project>
