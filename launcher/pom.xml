<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zincoid</groupId>
        <artifactId>nullbot-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>launcher</artifactId>
    <name>NullBot Launcher</name>
    <description>NullBot application entry and packaging</description>

    <dependencies>
        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Main -->
        <dependency>
            <groupId>com.zincoid</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <time>${maven.build.timestamp}</time>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <workingDirectory>${project.basedir}/..</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>adapter-shiro</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.zincoid</groupId>
                    <artifactId>adapter-shiro</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
            <build>
                <finalName>launcher-shiro</finalName>
            </build>
        </profile>
        <profile>
            <id>adapter-stdin</id>
            <dependencies>
                <dependency>
                    <groupId>com.zincoid</groupId>
                    <artifactId>adapter-stdin</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
            <build>
                <finalName>launcher-stdin</finalName>
            </build>
        </profile>
        <profile>
            <id>adapter-qq</id>
            <dependencies>
                <dependency>
                    <groupId>com.zincoid</groupId>
                    <artifactId>adapter-qq</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
            <build>
                <finalName>launcher-qq</finalName>
            </build>
        </profile>
    </profiles>
</project>
