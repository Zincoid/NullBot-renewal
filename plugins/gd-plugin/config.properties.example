# 插件首次加载时自动创建 workspace/plugins/gd/config.properties；也可手动复制本文件。
# Created automatically on first load; you can also copy this file manually.
# 环境变量 GD_* 优先于本文件。
# Environment variables GD_* take precedence.

# GDDL 与缩略图使用的 HTTP 代理，host:port；留空表示不使用代理。
# HTTP proxy for GDDL and thumbnails, host:port; empty disables it.
# 暂不支持代理认证。
# Proxy authentication is not supported.
http.proxy=

# 网络较慢时可适当增大；单位为秒。
# Increase these on a slow network; values are in seconds.
http.connect-timeout=8
http.request-timeout=15
http.retries=1

http.user-agent=NullBot-GD/1.0
gddl.api-base=https://gdladder.com/api
gddl.avatar-base=https://cdn.gdladder.com/avatars/
thumbnail.base=https://levelthumbs.prevter.me/thumbnail/

# GDDL、B20 与缩略图缓存时间，单位为秒。
# Cache lifetime for GDDL data, B20, and thumbnails, in seconds.
cache-ttl=600

# 本地 B20 的 GDDL 评级缓存时间，单位为秒。
# GDDL rating cache lifetime for local B20, in seconds.
# 已评级关卡默认 24 小时，未评级/未收录关卡默认 1 小时。
# Rated levels default to 24 hours; unrated or missing levels default to 1 hour.
gddl.tier-cache-ttl=86400
gddl.unrated-cache-ttl=3600

# B20 单关 rt 中 GDDL rating 的指数；设为 2 使用平方。
# GDDL rating exponent in the B20 formula; set to 2 to use squared ratings.
score.tier-exponent=1.5
