# ═══════ NullBot 部署配置文件 ═══════ #
# 生产环境使用，可完全不配置启动，此时：    #
# 1. 控制台身份校验 token 随机生成       #
# 2. 使用内置 sqlite 数据库            #
# 3. 其余配置为以下默认值                #
# ══════════════════════════════════ #

nullbot:
  # ─── 启动 ─────────── #
  port: 0

  # ─── 文档 ─────────── #
  docs:
    enabled: false

  # ─── 管理 ─────────── #
  console:
    token:

  # ─── 日志 ─────────── #
  log:
    path: ./logs/output.log
    level: INFO

  # ─── 数据 ─────────── #
  db:
    type: sqlite
    sqlite:
      path: ./data/sqlite.db
    mysql:
      host: localhost
      port: 3306
      database:
      username:
      password:

  # ─── 文件 ─────────── #
  file:
    root: ./files

  # ─── 连接 ─────────── #
  shiro:
    url: /ws
    token:

  # ─── 适配 ─────────── #
  adapter: shiro

  # ─── 插件 ─────────── #
  plugin:
    enabled: false
    dir: ./plugins
